# Copy to .env and adjust. Docker Compose reads this file for substitution.
# Do not commit .env. These values are local-development defaults only.

# Official image tag. Change this to move Odoo series (module manifest
# version prefix should follow the same series).
ODOO_VERSION=20.0

# Host port published for the Odoo HTTP service.
ODOO_HTTP_PORT=8069

# PostgreSQL role created by the database container.
# Odoo receives the same credentials through PGHOST/PGUSER/PGPASSWORD.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres
