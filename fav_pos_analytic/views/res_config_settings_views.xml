<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_outlet_analytic" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.outlet.analytic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']" position="after">
                <setting string="Outlet analytic account" id="fav_pos_outlet_analytic"
                    help="Tagged at 100% on income, discount, and other profit-and-loss lines when this register closes or invoices an order. Receivable, bank, cash, and tax lines are not tagged.">
                    <field name="pos_analytic_account_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
