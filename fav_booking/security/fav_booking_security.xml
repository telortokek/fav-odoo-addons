<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_fav">
        <field name="name">FAV</field>
        <field name="description">Rental bookings for FAV.</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_fav_booking">
        <field name="name">Booking</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_fav"/>
    </record>

    <record id="group_fav_booking_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_fav_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read and update FAV bookings. Cannot delete them.</field>
    </record>

    <record id="group_fav_booking_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_fav_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_fav_booking_user')), (4, ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manage bookings and create customers from the website payload.</field>
    </record>
</odoo>
