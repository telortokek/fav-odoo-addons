<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The board reads system parameters, not these floor fields. The view stays
         so an upgrade deactivates the old hours on the floor form. -->
    <record id="view_restaurant_floor_form_schedule" model="ir.ui.view">
        <field name="name">restaurant.floor.form.fav.schedule</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="fav_schedule_start" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
