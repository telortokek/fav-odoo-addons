<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fav_room_list" model="ir.ui.view">
        <field name="name">fav.room.list</field>
        <field name="model">fav.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="room_type"/>
                <field name="code"/>
                <field name="floor_id"/>
                <field name="table_id"/>
                <field name="table_room_name"/>
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fav_room_form" model="ir.ui.view">
        <field name="name">fav.room.form</field>
        <field name="model">fav.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="VIP PLUS 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="room_type"/>
                            <field name="sequence"/>
                            <field name="floor_id"/>
                            <field name="outlet_analytic_account_id"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="table_id"/>
                            <field name="table_room_name"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fav_room_search" model="ir.ui.view">
        <field name="name">fav.room.search</field>
        <field name="model">fav.room</field>
        <field name="arch" type="xml">
            <search string="Rooms">
                <field name="name"/>
                <field name="code"/>
                <field name="table_id"/>
                <field name="product_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fav_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">fav.room</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Link a bookable room to a POS table</p>
            <p>
                Each room points at a restaurant table and a product sold by the hour.
                The website sends the room code. The hourly price stays on the product.
            </p>
        </field>
    </record>
</odoo>
