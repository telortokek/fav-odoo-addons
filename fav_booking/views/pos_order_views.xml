<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_fav_booking" model="ir.ui.view">
        <field name="name">pos.order.form.fav.booking</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fav_booking_id" groups="fav_booking.group_fav_booking_user"/>
            </xpath>
        </field>
    </record>
</odoo>
