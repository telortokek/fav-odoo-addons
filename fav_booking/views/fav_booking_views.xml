<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fav_booking_list" model="ir.ui.view">
        <field name="name">fav.booking.list</field>
        <field name="model">fav.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings" create="0" duplicate="0" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="room_id"/>
                <field name="product_id" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="external_ref" optional="show"/>
                <field name="amount_total" sum="Total" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'confirmed'"
                    decoration-warning="state == 'checked_in'"
                    decoration-success="state == 'done'"
                    decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fav_booking_form" model="ir.ui.view">
        <field name="name">fav.booking.form</field>
        <field name="model">fav.booking</field>
        <field name="arch" type="xml">
            <form string="Booking" create="0" duplicate="0">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check In"
                        class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" type="object" string="Done"
                        class="btn-primary" invisible="state != 'checked_in'"/>
                    <button name="action_create_sale_order" type="object" string="Create Sales Order"
                        groups="sales_team.group_sale_salesman"
                        invisible="sale_order_id or state in ('draft', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state not in ('draft', 'confirmed', 'checked_in')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                        invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,checked_in,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object"
                            class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="not sale_order_id"
                            groups="sales_team.group_sale_salesman">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sales Order</span>
                            </div>
                        </button>
                        <button name="action_open_pos_order" type="object"
                            class="oe_stat_button" icon="fa-shopping-cart"
                            invisible="not pos_order_id"
                            groups="point_of_sale.group_pos_user">
                            <div class="o_stat_info">
                                <span class="o_stat_text">POS Order</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                        invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="room_id"/>
                            <field name="product_id"/>
                            <field name="external_ref"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_hours"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <field name="amount_untaxed"/>
                        <field name="amount_tax"/>
                        <field name="amount_total"/>
                        <field name="amount_down_payment"/>
                    </group>
                    <group string="Links">
                        <field name="sale_order_id" groups="sales_team.group_sale_salesman"/>
                        <field name="pos_order_id" groups="point_of_sale.group_pos_user"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Notes from the website or the desk"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fav_booking_search" model="ir.ui.view">
        <field name="name">fav.booking.search</field>
        <field name="model">fav.booking</field>
        <field name="arch" type="xml">
            <search string="Bookings">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="room_id"/>
                <field name="external_ref"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_checked_in" string="Checked In" domain="[('state', '=', 'checked_in')]"/>
                <filter name="filter_open" string="Open"
                    domain="[('state', 'in', ('draft', 'confirmed', 'checked_in'))]"/>
                <separator/>
                <filter name="filter_date_start" string="Start" date="date_start"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="group_product" string="Resource" context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_start" string="Start" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fav_booking_calendar" model="ir.ui.view">
        <field name="name">fav.booking.calendar</field>
        <field name="model">fav.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings" date_start="date_start" date_stop="date_end"
                color="room_id" mode="week" create="0" quick_create="0" event_open_popup="0">
                <field name="partner_id"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_fav_booking_kanban" model="ir.ui.view">
        <field name="name">fav.booking.kanban</field>
        <field name="model">fav.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="room_id" create="0" sample="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="partner_id"/>
                        <field name="room_id"/>
                        <div>
                            <field name="date_start"/>
                            <span> → </span>
                            <field name="date_end"/>
                        </div>
                        <field name="state" widget="badge"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_fav_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">fav.booking</field>
        <field name="view_mode">calendar,list,kanban,form</field>
        <field name="search_view_id" ref="view_fav_booking_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bookings yet
            </p>
            <p>
                Bookings arrive from the website. Staff confirm them and check the guest in,
                which opens the POS bill on the room's table.
            </p>
        </field>
    </record>
</odoo>
