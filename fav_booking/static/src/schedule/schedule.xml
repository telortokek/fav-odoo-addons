<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fav_booking.Schedule">
        <div class="o_fav_schedule d-flex flex-column h-100 bg-view">
            <div class="o_fav_schedule_toolbar d-flex flex-wrap align-items-center gap-2 p-2 border-bottom">
                <div class="btn-group" role="group">
                    <button type="button"
                        t-attf-class="btn {{ this.state.mode == 'day' ? 'btn-primary' : 'btn-secondary' }}"
                        t-on-click="() => this.setMode('day')">Day</button>
                    <button type="button"
                        t-attf-class="btn {{ this.state.mode == 'week' ? 'btn-primary' : 'btn-secondary' }}"
                        t-on-click="() => this.setMode('week')">7 days</button>
                </div>
                <button type="button" class="btn btn-secondary" t-on-click="this.prevDay">Previous</button>
                <input type="date" class="form-control o_fav_schedule_date" t-att-value="this.state.day" t-on-change="this.onDate"/>
                <button type="button" class="btn btn-secondary" t-on-click="this.goToday">Today</button>
                <button type="button" class="btn btn-secondary" t-on-click="this.nextDay">Next</button>
                <select class="form-select o_fav_schedule_outlet" t-att-value="this.state.floorId" t-on-change="this.onFloor">
                    <t t-foreach="this.state.data and this.state.data.floors or []" t-as="floor" t-key="floor.id">
                        <option t-att-value="floor.id" t-att-selected="floor.id == this.state.floorId" t-out="floor.name"/>
                    </t>
                </select>
                <span class="text-muted" t-if="this.state.data">
                    <t t-out="this.state.data.tz"/>
                </span>
                <div class="o_fav_legend ms-auto d-flex align-items-center gap-2">
                    <span class="o_fav_legend_item o_fav_state_confirmed">Confirmed</span>
                    <span class="o_fav_legend_item o_fav_state_checked_in">Checked in</span>
                    <span class="o_fav_legend_item o_fav_state_done">Done</span>
                </div>
            </div>
            <div class="o_fav_schedule_scroll flex-grow-1">
                <t t-if="this.state.data and this.rooms.length">
                    <div class="o_fav_schedule_days">
                        <t t-foreach="this.boards" t-as="board" t-key="board.day">
                            <section class="o_fav_schedule_day">
                                <table>
                                    <thead>
                                        <tr>
                                            <th t-att-class="this.dateClass(board, board_index)" t-att-colspan="this.rooms.length + 1" t-out="board.label"/>
                                        </tr>
                                        <tr>
                                            <th class="o_fav_jam">JAM</th>
                                            <t t-foreach="this.rooms" t-as="room" t-key="room.id">
                                                <th class="o_fav_room_head" t-att-style="this.roomHeadStyle(room)" t-out="room.name"/>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.slots" t-as="slot" t-key="slot.index">
                                            <tr t-att-class="this.rowClass(board, slot)">
                                                <th class="o_fav_jam" t-out="slot.label"/>
                                                <t t-foreach="this.rooms" t-as="room" t-key="room.id">
                                                    <t t-set="cell" t-value="this.cell(board, room.id, slot.index)"/>
                                                    <td t-if="cell.show"
                                                        class="o_fav_tint o_fav_book_cell"
                                                        t-att-style="this.roomCellStyle(room)"
                                                        t-att-rowspan="cell.slot_span">
                                                        <button type="button"
                                                            t-attf-class="o_fav_booked o_fav_state_{{ cell.state }} {{ this.blockIsNow(board, cell) ? 'o_fav_now_block' : '' }}"
                                                            t-on-click="() => this.openBooking(cell)">
                                                            <span class="o_fav_name" t-out="cell.partner"/>
                                                            <span class="o_fav_time" t-out="cell.time_label"/>
                                                        </button>
                                                    </td>
                                                    <td t-elif="cell.empty" class="o_fav_tint" t-att-style="this.roomCellStyle(room)"/>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </section>
                        </t>
                    </div>
                </t>
                <div t-else="" class="p-4 text-muted">No rooms for this outlet.</div>
            </div>
        </div>
    </t>
</templates>
