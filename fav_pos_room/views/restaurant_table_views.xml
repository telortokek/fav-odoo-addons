<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_floor_form_room_name" model="ir.ui.view">
        <field name="name">restaurant.floor.form.room.name</field>
        <field name="model">restaurant.floor</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_floor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='table_ids']//field[@name='table_number']" position="after">
                <field name="room_name"/>
            </xpath>
        </field>
    </record>

    <record id="view_restaurant_table_form_room_name" model="ir.ui.view">
        <field name="name">restaurant.table.form.room.name</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='table_number']" position="after">
                <field name="room_name"/>
            </xpath>
        </field>
    </record>
</odoo>
